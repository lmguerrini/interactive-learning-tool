# Copy this file to .env and fill in your values.
OPENAI_API_KEY=""

# Optional model configuration
LLM_MODEL="gpt-4o"

# Optional generation tuning
LLM_TEMPERATURE="0.2"
LLM_MAX_COMPLETION_TOKENS="800"

# Optional reliability settings
LLM_MAX_RETRIES="2"
LLM_RETRY_MAX_BACKOFF_SECONDS="8.0"

# Optional structured output wrapper
USE_INSTRUCTOR="false"